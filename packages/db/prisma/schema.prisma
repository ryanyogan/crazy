// Crazy's data model. Runs on Cloudflare D1, which is the only source of truth
// (ADR 0002). Vocabulary is the glossary in CONTEXT.md.
//
// Conventions
//  - Every row carries userId (the Clerk user id); queries always filter by it.
//  - SQLite has no enums: string columns hold the vocabularies in @crazy/shared.
//  - No column defaults to the current time. The moment is always handed in by
//    the caller, so screens and the Rollover can be tested at a pinned time.
//  - Only the Coordinator writes (see src/write.ts).
//  - A day is the user's local date, "2025-09-17", never a moment.
//  - Ids are handed in by the writer (nothing defaults), so a seed is repeatable.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "cloudflare"
  // "One Source, one open Todo" is a unique index over open Todos only.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

/// One row per user, created on their first authenticated request.
model UserSettings {
  userId       String   @id // Clerk user id
  timeZone     String   @default("UTC") // IANA name; decides the Rollover's midnight
  briefTime    String   @default("06:00") // local HH:MM
  sentBackDays Int      @default(1)
  archiveDays  Int      @default(90)
  billing      Boolean  @default(false) // the Billing module
  createdAt    DateTime

  @@map("user_settings")
}

/// One user's authorised link to one account at a Provider (ADR 0001): a Clerk
/// external account plus this bookkeeping row. No token is ever stored.
model Connection {
  id                String    @id
  userId            String
  provider          String // PROVIDERS in @crazy/shared
  externalAccountId String // Clerk's id for the external account
  defaultSide       String // the Side of a Todo that arrives with no Circle
  status            String // CONNECTION_STATUSES
  syncCursor        String?
  lastSyncAt        DateTime?
  createdAt         DateTime
  todos             Todo[]
  calendarEvents    CalendarEvent[]
  signals           Signal[]

  @@unique([userId, externalAccountId])
  @@map("connection")
}

/// A group of people and tools a user moves in. The only place a Side is stored.
/// Crazy infers a Circle, so `people` and `providers` are inferred with it: how
/// many people it holds, and the Providers its work lives in (SOURCE_KINDS,
/// comma separated). Both are null until Crazy has looked.
model Circle {
  id        String        @id
  userId    String
  name      String
  side      String // SIDES
  people    Int?
  providers String?
  createdAt DateTime
  projects  Project[]
  todos     CircleMatch[]

  @@index([userId])
  @@map("circle")
}

/// One Todo matched to one Circle. A Todo matched to more than one Circle is an
/// **Overlap**: doing it serves both. An Overlap is never a row of its own — it
/// is read off these matches, so nothing can say a Todo overlaps and not match.
model CircleMatch {
  id        String   @id
  userId    String
  todoId    String
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdAt DateTime

  @@unique([todoId, circleId])
  // The Circles read model: a user's matches, and one Todo's Circles.
  @@index([userId])
  @@map("circle_match")
}

/// How Crazy worded one Overlap on the Circles screen: why the Todo serves both
/// Circles, who is in it, when it lands, and the two short lines it writes where
/// those Circles meet on the figure. Generated text, like the Brief. The Overlap
/// itself is the Todo's matches; a Todo with a note and one match is not one.
model OverlapNote {
  id        String   @id
  userId    String
  todoId    String   @unique
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  text      String
  people    String
  /// When the Overlap lands, in words: "Today 13:00 → 14:00". Written, not read
  /// off the Todo's Slots, so once a Todo can be slotted (ticket 08) the two can
  /// disagree. Which wins is undecided; nothing reconciles them yet.
  timing    String
  figureTitle String?
  figureNote  String?
  createdAt DateTime

  @@index([userId])
  @@map("overlap_note")
}

/// A named body of work. Progress is derived from its Todos, never stored.
model Project {
  id           String   @id
  userId       String
  circleId     String?
  circle       Circle?  @relation(fields: [circleId], references: [id])
  name         String
  status       String // PROJECT_STATUSES
  statusNote   String? // shown in place of the status's own label: "Week 9 of 12"
  milestone    String? // the next milestone, in words
  milestoneDay String? // and the day it falls on
  createdAt    DateTime
  todos        Todo[]
  tieIns       TieIn[]

  @@index([userId])
  @@map("project")
}

/// Where a user ties into one Project in one week: what the Week screen's card
/// says, and when it falls. Generated text written for a week, like the Week
/// brief, so a week Crazy has not written about shows none.
model TieIn {
  id        String   @id
  userId    String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  week      String // the week's Monday, as the user's local date
  text      String
  when      String? // when it falls, in words: "Milestone Fri"
  createdAt DateTime

  @@unique([userId, projectId, week])
  // The Week read model: a user's tie-ins for one week.
  @@index([userId, week])
  @@map("tie_in")
}

/// One thing a person intends to do. No Project makes it a One-off.
model Todo {
  id              String    @id
  userId          String
  title           String
  state           String // TODO_STATES
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id])
  estimateMinutes Int?
  energy          String? // ENERGIES
  /// Rollovers in a row this Todo has been carried over. Reset when sent back.
  carryCount      Int       @default(0)
  /// Its place in the Priority stack, and the one line that explains it.
  stackPosition   Int?
  stackReason     String?
  /// The Provider item this Todo was made from; a typed-in Todo has none.
  sourceConnectionId String?
  sourceConnection   Connection? @relation(fields: [sourceConnectionId], references: [id])
  sourceKind         String? // SOURCE_KINDS
  sourceItemId       String? // the item's id at the Provider
  sourceRef          String? // what people call the item: "HAL-212"
  sourceUrl          String?
  createdAt       DateTime
  touchedAt       DateTime // the last time the user touched it
  /// While this moment is still to come the Todo is out of the Priority stack.
  snoozedUntil    DateTime?
  sentBackAt      DateTime? // the Rollover that last sent it back
  doneAt          DateTime?
  slots           Slot[]
  signals         Signal[]
  /// The Circles it is matched to. More than one makes it an Overlap.
  circles         CircleMatch[]
  overlapNote     OverlapNote?
  weekDayLines    WeekDayLine[]

  // The Today read model: a user's `today` Todos in stack order.
  @@index([userId, state, stackPosition])
  // The Week read model, and Today's done-today: a user's Todos finished in a span.
  @@index([userId, state, doneAt])
  // One Source, one open Todo.
  @@unique([userId, sourceConnectionId, sourceItemId], where: raw("state IN ('backlog', 'today')"))
  @@map("todo")
}

/// An hour of a day that a Todo has been placed on. A Todo that runs two hours
/// holds two Slots.
model Slot {
  id        String   @id
  userId    String
  todoId    String
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  day       String
  hour      Int // 0–23 on the user's wall clock
  createdAt DateTime

  @@unique([todoId, day, hour])
  @@index([userId, day])
  @@map("slot")
}

/// A meeting or focus block read from a Provider's calendar. Crazy never edits
/// one: it occupies hours of the timeline and is not a Slot.
model CalendarEvent {
  id           String     @id
  userId       String
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id])
  itemId       String // the event's id at the Provider
  kind         String // CALENDAR_EVENT_KINDS
  title        String
  who          String? // who it is with, as the Provider puts it: "12 people"
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime
  weekDayLines WeekDayLine[]

  @@unique([userId, connectionId, itemId])
  // The Today and Week read models: a user's events over a span of days.
  @@index([userId, startsAt])
  @@map("calendar_event")
}

/// How Crazy worded one hour of a day's timeline when it last planned the day.
/// Generated text, like the Brief. An hour without a row is worded from what
/// it holds, and how an hour is drawn is always derived, never stored.
model TimelineHour {
  id         String   @id
  userId     String
  day        String
  hour       Int // 0–23 on the user's wall clock
  title      String
  note       String?
  sourceKind String? // SOURCE_KINDS: the chip the hour wears
  /// The Todos that held a Slot on this hour when these words were written, as
  /// a sorted JSON array of Todo ids; "[]" for an hour worded with none on it.
  /// The words hold only while the hour still holds exactly those Todos: once
  /// the user re-plans it, the hour is worded from what it holds now. Nothing
  /// deletes the row, so taking the Todo off again brings Crazy's words back.
  writtenFor String   @default("[]")
  createdAt  DateTime

  @@unique([userId, day, hour])
  @@map("timeline_hour")
}

/// The words Crazy adds beside the figures it computes for one day of the Week
/// screen: "Q4 held". Generated text, like the Brief. Never a number — every
/// figure the day card shows is computed from Todos when it is read.
model WeekDayNote {
  id        String   @id
  userId    String
  day       String // the user's local date
  text      String
  createdAt DateTime

  @@unique([userId, day])
  @@map("week_day_note")
}

/// How Crazy words one thing on a day of the Week screen — a Todo or a meeting,
/// said in the few words a day card has room for ("Session spike"). Generated
/// text, like the timeline's hours, and kept beside the thing it words, so a
/// line is shown only while that thing is still on the day. How long a Todo has
/// been carried is derived from the Todo, never written into the words.
model WeekDayLine {
  id              String         @id
  userId          String
  day             String // the user's local date
  position        Int // among the day's lines, top first
  text            String
  todoId          String?
  todo            Todo?          @relation(fields: [todoId], references: [id], onDelete: Cascade)
  calendarEventId String?
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  createdAt       DateTime

  // The Week read model: a user's wording over a span of days.
  @@unique([userId, day, position])
  @@map("week_day_line")
}

/// Something Crazy noticed at a Provider that might deserve a Todo. It never
/// becomes one on its own: the user adds it, and `todoId` records that they did.
model Signal {
  id           String     @id
  userId       String
  kind         String // SIGNAL_KINDS
  person       String // who addressed the user, was promised something, or owes them
  text         String
  at           DateTime // when it happened at the Provider
  /// The Provider item it is. A Todo made from it takes this as its Source.
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id])
  sourceKind   String // SOURCE_KINDS
  sourceItemId String
  sourceRef    String?
  sourceUrl    String?
  /// The Todo the user added it as.
  todoId       String?
  todo         Todo?      @relation(fields: [todoId], references: [id], onDelete: SetNull)
  createdAt    DateTime

  @@unique([userId, connectionId, sourceItemId, kind])
  // The Today and Projects read models: a user's Signals of a kind, newest first.
  @@index([userId, kind, at])
  @@map("signal")
}

/// What Crazy wrote for a user: the Brief each morning, the Week brief each week.
model Brief {
  id        String   @id
  userId    String
  kind      String // BRIEF_KINDS
  day       String // the day it was written for; a Week brief's is its Monday
  body      String
  bodyShort String // the same, said in a phone's width
  createdAt DateTime

  @@unique([userId, kind, day])
  @@map("brief")
}
